# URL Utama untuk Backend / Server API kamu
# Buka file ini dan simpan sebagai ".env" (tanpa .example) 
# kemudian sesuaikan isinya dengan domain VPS kamu.
VITE_API_URL=https://your-api-domain.com/api

# Base URL untuk Endpoint API
# Secara default mengikuti VITE_API_URL ditambah "/api"
VITE_API_BASE=https://your-api-domain.com/api