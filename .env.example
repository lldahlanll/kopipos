# ══════════════════════════════════════════════════════════════════════════════
# KopiPOS — Template Konfigurasi
# Salin jadi .env lalu isi:   cp .env.example .env
# File .env TIDAK boleh di-commit ke git (sudah ada di .gitignore).
# Setelah mengubah .env, jalankan:  docker compose up -d
# ══════════════════════════════════════════════════════════════════════════════

# ─── Aplikasi ─────────────────────────────────────────────────────────────────
# "production"  : dipakai di server
# "development" : dev lokal (SECRET_KEY boleh kosong → pakai key default bawaan)
APP_ENV=production

# Domain publik, dipakai untuk CORS. Lokal: http://localhost:5173
APP_URL=https://kopipos.example.com

SHOP_NAME=KopiPOS Coffee Shop

# ─── Database (PostgreSQL di Docker) ──────────────────────────────────────────
# Cukup diisi di sini. docker-compose.yml merakit DATABASE_URL untuk backend:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
# Pakai password huruf + angka saja (karakter seperti @ : / # % ? merusak URL).
# Buat password acak:  openssl rand -hex 16
POSTGRES_USER=kopipos
POSTGRES_DB=kopipos
POSTGRES_PASSWORD=ganti-password-ini

# ⚠️  Ganti password database yang SUDAH berjalan:
# Postgres hanya membaca POSTGRES_PASSWORD saat volume pertama kali dibuat.
# Mengubah .env saja TIDAK cukup — jalankan juga:
#   1. Ubah POSTGRES_PASSWORD di .env
#   2. docker exec -it kopipos_db psql -U kopipos -d kopipos \
#        -c "ALTER USER kopipos WITH PASSWORD 'password-baru';"
#   3. docker compose up -d
#
# Dev lokal TANPA Docker: jangan isi apa pun → backend otomatis pakai SQLite.
# Atau set manual, misalnya:  DATABASE_URL=sqlite:///kopipos.db

# ─── Keamanan / Login ─────────────────────────────────────────────────────────
# Wajib diisi di production. Buat key acak:  openssl rand -hex 32
# Jika kosong di production → auto-generate ke backend/.secret_key
# Mengganti SECRET_KEY = semua user harus login ulang.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Midtrans Payment Gateway ─────────────────────────────────────────────────
# Midtrans Dashboard → Settings → Access Keys
# false = Sandbox (testing), true = Production (uang sungguhan)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
