# ─── Mode Aplikasi ────────────────────────────────────────────────────────────
# "development" : SECRET_KEY pakai default bawaan (aman untuk dev lokal, TIDAK untuk production)
# "production"  : SECRET_KEY auto-generate otomatis & disimpan ke file .secret_key,
#                 atau bisa diisi manual di bawah ini.
APP_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev lokal):
# DATABASE_URL=sqlite:///kopipos.db
# PostgreSQL (production/Docker):
DATABASE_URL=postgresql://kopipos:kopipos123@localhost:5432/kopipos

# ─── Secret Key ────────────────────────────────────────────────────────────────
# Opsional di mode development. Di mode production:
#   - Jika diisi di sini → dipakai langsung (direkomendasikan untuk prod yang serius)
#   - Jika dikosongkan  → auto-generate & disimpan ke file backend/.secret_key
# SECRET_KEY=isi-key-acak-panjang-di-sini

# ─── Lainnya ───────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SHOP_NAME=KopiPOS Coffee Shop
